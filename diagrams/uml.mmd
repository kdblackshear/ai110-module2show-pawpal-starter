classDiagram
    class OwnerPreferences {
        +int max_daily_minutes
        +Dict priority_weights
        +List preferred_walk_windows
        +update_max_minutes(new_limit)
        +add_walk_window(start, end)
    }

    class Pet {
        +String pet_id
        +String name
        +String type
        +String special_notes
        +List tasks
        +update_notes(new_notes)
        +get_profile_summary()
    }

    class Task {
        +String task_id
        +String pet_id
        +String title
        +String category
        +int duration_minutes
        +String priority
        +DateTime scheduled_time
        +bool is_completed
        +mark_completed()
        +reschedule(new_time)
        +update_priority(new_priority)
    }

    class ScheduleManager {
        +Dict pets
        +List tasks
        +OwnerPreferences preferences
        +add_pet(pet_object)
        +schedule_task(task_object)
        +get_todays_tasks()
        +generate_daily_plan()
    }

    ScheduleManager "1" --> "*" Pet : manages
    ScheduleManager "1" --> "*" Task : tracks
    ScheduleManager "1" --> "1" OwnerPreferences : uses